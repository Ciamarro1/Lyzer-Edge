# Lyzer Labs V3 - Environment Configuration
# Copy this file to .env and fill in your keys.

# Binance Testnet API Keys (https://testnet.binance.vision/)
# Create an account on the Testnet and generate API keys here.
BINANCE_API_KEY=YOUR_API_KEY_HERE
BINANCE_API_SECRET=YOUR_API_SECRET_HERE

# Mode configurations: SIMULATION | TESTNET | LIVE
ARL_MODE=TESTNET

# Trading Safeguards
LIVE_TRADING_ENABLED=false
MAX_DAILY_CAPITAL=1000  # Em USDT

# === EXPERIMENTAL: RELAXATION CONTROLS (QUANT SNIPER CALIBRATION) ===
# Truth Kernel / ExecutionTriggerLayer: minimum TRG to allow execution (default 0.30 for Sniper Mode)
TRG_THRESHOLD=0.30

# Residualization Layer: divergence below this threshold is considered "consensus"
# and DVF is forced to 0 (blocking trades). Set to 0 to disable consensus destruction.
RESIDUAL_CONSENSUS_LIMIT=0.1

# C-CLIST: DVF below this floor accumulates stress (default 0.1)
CCLIST_DVF_FLOOR=0.1

# C-CLIST: stress accumulated per tick when DVF is below floor (default 0.002)
CCLIST_STRESS_ACCUMULATION=0.002

# C-CLIST: stress level at which execution is blocked (default 0.9)
CCLIST_LETHAL_ILLUSION_LIMIT=0.9

# C-CLIST: stress released when DVF is above floor (default 0.1)
CCLIST_STRESS_RELEASE=0.1

# MOL: minimum consecutive stable ticks needed to exit RECOVERY state (default 3)
MOL_SCL_THRESHOLD=3

# TruthKernel: LHDS above this triggers VETO (default 0.95 for Sniper Mode)
LHDS_VETO_LIMIT=0.95

# TruthKernel: ontological collapse TRG threshold when SDS > 0.7 (default 0.7)
ONTOLOGICAL_COLLAPSE_TRG=0.7

# MOL: Boot stabilization grace period in ms before allowing trade entries (default 45000 = 45 seconds)
MOL_STABILIZATION_WINDOW_MS=45000

# Proxy setting used to bypass geo-blocks
BINANCE_PROXY=

# === TELEMETRY & ALERTS ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === PIPELINE ABLATION & ARCHITECTURE ===
# Disable specific signal providers (comma-separated, e.g. v1,v3 - proven optimal for alpha)
DISABLED_PROVIDERS=v1,v3

# Multi-Asset Ingestion Fleet (All 6 primary pairs)
ACTIVE_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,ADAUSDT

# TRG curve steepness (default 2)
TRG_EXPONENT=2

# Enable directional logic overrides (Sniper Mode: Long-Only by default)
LONG_ENABLED=true
SHORT_ENABLED=false
ALLOW_SHORTS=false

# Enforce Microstructure OOS-11 Rules (Order Book Imbalance)
ENFORCE_OOS11_RULES=false

# Disable LHDS checks for pure structural simulation
ABLATION_NO_LHDS=false

# Enable Shadow Trading (RealityGapMonitor)
SHADOW_TRADING_ENABLED=false

# === EXIT POLICY & TIME HORIZON ===
# Exit Policy: TIME | DYNAMIC_TP | HYBRID_SCALE_OUT (default: TIME)
EXIT_POLICY=TIME
TIME_EXIT_MINUTES=15

# === SYSTEM & INFRASTRUCTURE ===
PORT=7860
DATA_DIR=/tmp/data
DB_PATH=/tmp/data/historical_causal_memory.db
NATS_URL=nats://localhost:4222
