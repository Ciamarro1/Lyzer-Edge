{
  "name": "lyzer-institutional-ecosystem",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "lyzer edge"
  ],
  "scripts": {
    "build": "npm run build --workspace=\"lyzer edge\"",
    "start": "node --max-old-space-size=384 \"lyzer edge/backend/server.js\"",
    "backend": "node --max-old-space-size=384 \"lyzer edge/backend/server.js\"",
    "test:p0": "npm run test:p0 --workspace=\"lyzer edge\""
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true,
    "protobufjs@7.6.4": true,
    "sqlite3@6.0.1": true
  },
  "dependencies": {
    "@huggingface/hub": "^2.13.2",
    "isomorphic-git": "^1.38.6"
  },
  "devDependencies": {
    "jsdom": "^30.0.1"
  }
}
